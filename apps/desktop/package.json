{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Electron desktop shell for DeepSeek Harness: runs the dsh web profile as a sidecar process and hosts the official Web UI in a native window.",
  "version": "0.1.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist/**"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "desktop:test:e2e": "vitest run --config vitest.e2e.config.ts",
    "desktop:dev": "tsc -p tsconfig.json && electron .",
    "desktop:pack": "tsc -p tsconfig.json && node scripts/pack.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
